{
  "expo": {
    "name": "Trackwise",
    "slug": "trackwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/branding/logo.png",
    "scheme": "trackwise",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.trackwise.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Trackwise uses the camera to scan food barcodes.",
        "NSPhotoLibraryUsageDescription": "Trackwise needs photo access so you can add an image to a food you create."
      }
    },
    "android": {
      "package": "com.trackwise.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#00D95F",
        "foregroundImage": "./assets/images/branding/logo.png"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/branding/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00D95F",
          "image": "./assets/images/branding/logo.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Trackwise to use the camera for barcode scanning.",
          "recordAudioAndroid": false
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Trackwise to access your photos to add a food image.",
          "cameraPermission": "Trackwise uses the camera to scan food barcodes."
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-localization",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}