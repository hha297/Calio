{
  "expo": {
    "name": "Calio",
    "slug": "calio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "calio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.calio.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Calio uses the camera to scan food barcodes."
      }
    },
    "android": {
      "package": "com.calio.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#69B32B",
        "foregroundImage": "./assets/images/logo.png"
      },
      "permissions": ["CAMERA", "android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#69B32B",
          "image": "./assets/images/translogo.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Calio to use the camera for barcode scanning.",
          "recordAudioAndroid": false
        }
      ],
      "expo-image",
      "expo-image-picker",
      "expo-web-browser",
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
